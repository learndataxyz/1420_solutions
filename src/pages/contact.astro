---
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import PageHeader from "@/partials/PageHeader.astro";

const contactIndex = await getListPage("contact", "-index");
const { contact_form_action }: { contact_form_action: string } = config.params;
const { title, description, meta_title, image } = contactIndex.data;

const buildDrafts = process.argv.includes("--buildDrafts");
if (!buildDrafts && contactIndex.data.draft) {
  return Astro.redirect("/404");
}
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <PageHeader title={title} />
  <section class="section-sm">
    <div class="container">
      <div class="row">
        <div class="mx-auto md:col-10 lg:col-6">
          <form action={contact_form_action} method="POST">
            <div class="mb-6">
              <label for="name" class="form-label">
                Full Name <span class="text-red-500">*</span>
              </label>
              <input
                id="name"
                name="name"
                class="form-input"
                placeholder="John Doe"
                type="text"
                required
              />
            </div>
            <div class="mb-6">
              <label for="email" class="form-label">
                Work Email <span class="text-red-500">*</span>
              </label>
              <input
                id="email"
                name="email"
                class="form-input"
                placeholder="john.doe@company.com"
                type="email"
                required
              />
            </div>
            <div class="mb-6">
              <label for="phone" class="form-label">
                Phone Number
              </label>
              <input
                id="phone"
                name="phone"
                class="form-input"
                placeholder="+1 (555) 555-1234"
                type="tel"
              />
            </div>
            <div class="mb-6">
              <label for="company" class="form-label">
                Company Name
              </label>
              <input
                id="company"
                name="company"
                class="form-input"
                placeholder="Your company"
                type="text"
              />
            </div>
            <div class="mb-6">
              <label for="industry" class="form-label">
                Industry <span class="text-red-500">*</span>
              </label>
              <select id="industry" name="industry" class="form-input" required>
                <option value="">Select industry</option>
                <option>Education</option>
                <option>Hospitality</option>
                <option>Gym & Fitness</option>
                <option>Manufacturing</option>
                <option>Real Estate & Construction</option>
                <option>Hospitals & Healthcare</option>
                <option>Other</option>
              </select>
            </div>
            <div class="mb-6">
              <label for="service_interest" class="form-label">
                Service Interest <span class="text-red-500">*</span>
              </label>
              <select id="service_interest" name="service_interest" class="form-input" required>
                <option value="">Select service</option>
                <option>ERP Implementation</option>
                <option>Custom Software Development</option>
                <option>AI Solutions</option>
                <option>Data Analysis & Reporting</option>
              </select>
            </div>
            <div class="mb-6">
              <label for="company_size" class="form-label">
                Company Size
              </label>
              <select id="company_size" name="company_size" class="form-input">
                <option value="">Select size</option>
                <option>1-10</option>
                <option>11-50</option>
                <option>51-200</option>
                <option>201-500</option>
                <option>500+</option>
              </select>
            </div>
            <div class="mb-6">
              <label for="message" class="form-label">
                Tell us about your operation <span class="text-red-500">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                class="form-input"
                placeholder="What are your current pain points or goals?"
                required
                rows="8"></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Request a Consultation</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Base>
